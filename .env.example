NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=4400
POSTGRES_USER=signal
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=signal_engine
DATABASE_URL=postgresql://signal:replace-with-a-strong-password@localhost:5432/signal_engine
REDIS_URL=redis://localhost:6379
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_CHAT_IDS=
BINANCE_BASE_URL=https://fapi.binance.com
OANDA_BASE_URL=https://api-fxpractice.oanda.com
OANDA_ACCOUNT_ID=
OANDA_API_TOKEN=
ADMIN_API_KEY=replace-with-a-long-random-secret-at-least-16-chars
RATE_LIMIT_PER_MINUTE=120
SYSTEM_STALE_SECONDS=900
CRYPTO_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT,SOLUSDT,XRPUSDT,DOGEUSDT,ADAUSDT,LINKUSDT,AVAXUSDT,LTCUSDT,DOTUSDT,TRXUSDT,TONUSDT,SUIUSDT,NEARUSDT,APTUSDT,ARBUSDT,OPUSDT,UNIUSDT,BCHUSDT
FOREX_SYMBOLS=EUR_USD,GBP_USD,USD_JPY,EUR_JPY,XAU_USD
PAPER_ROUND_TRIP_COST_BPS=12
PAPER_FUNDING_BPS_PER_8H=0
RUN_INITIAL_BACKFILL=false
BACKFILL_START=2025-01-01T00:00:00Z
BACKFILL_END=2025-02-01T00:00:00Z
BACKFILL_CHUNK_DAYS=30
BACKFILL_JOBS_PER_RUN=2
BACKFILL_REQUEST_INTERVAL_MS=60000
MIN_BACKTEST_TRADES=30
MIN_OOS_TRADES=10
RETENTION_NOTIFICATION_DAYS=14
RETENTION_ALERT_DAYS=30
RESEARCH_SERVICE_URL=http://localhost:8000
INGEST_INTERVAL_MS=300000
SCAN_INTERVAL_MS=60000
PAPER_INTERVAL_MS=60000
NOTIFICATION_INTERVAL_MS=10000
BACKTEST_INTERVAL_MS=30000
MONITOR_INTERVAL_MS=60000
LOG_LEVEL=info
