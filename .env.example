BACKFILL_JOBS_PER_RUN=2
BACKFILL_REQUEST_INTERVAL_MS=60000
MIN_BACKTEST_TRADES=30
MIN_OOS_TRADES=10
RETENTION_NOTIFICATION_DAYS=14
RETENTION_ALERT_DAYS=30
RESEARCH_SERVICE_URL=http://localhost:8000
INGEST_INTERVAL_MS=300000
FOREX_INGEST_INTERVAL_MS=300000
FOREX_POLL_1D_MINUTES=1440
FOREX_POLL_4H_MINUTES=240
FOREX_POLL_1H_MINUTES=60
FOREX_POLL_15M_MINUTES=30
FOREX_POLL_5M_MINUTES=360
FOREX_POLL_1M_MINUTES=720
FOREX_MAX_REQUESTS_PER_RUN=5
FOREX_DAILY_CREDIT_BUDGET=640
FOREX_CREDIT_SAFETY_MARGIN=80
FOREX_REQUEST_DELAY_MS=8000
SCAN_INTERVAL_MS=60000
PAPER_INTERVAL_MS=60000
NOTIFICATION_INTERVAL_MS=10000
BACKTEST_INTERVAL_MS=30000
