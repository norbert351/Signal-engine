{
  "name": "@signal-engine/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./repository": {
      "types": "./dist/repository.d.ts",
      "import": "./dist/repository.js"
    },
    "./scanner-repository": {
      "types": "./dist/scanner-repository.d.ts",
      "import": "./dist/scanner-repository.js"
    },
    "./ingestion-repository": {
      "types": "./dist/ingestion-repository.d.ts",
      "import": "./dist/ingestion-repository.js"
    },
    "./admin-repository": {
      "types": "./dist/admin-repository.d.ts",
      "import": "./dist/admin-repository.js"
    },
    "./backtest-repository": {
      "types": "./dist/backtest-repository.d.ts",
      "import": "./dist/backtest-repository.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/migrate.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.44.0",
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.9.0",
    "tsx": "^4.19.0"
  }
}