FROM node:22-alpine AS build
WORKDIR /app
RUN corepack enable
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm --filter @signal-engine/worker... build

FROM node:22-alpine
WORKDIR /app
COPY --from=build /app /app
ENV NODE_ENV=production
USER node
HEALTHCHECK --interval=30s --timeout=8s --start-period=30s --retries=3 CMD ["node","apps/worker/dist/healthcheck.js"]
CMD ["node","apps/worker/dist/main.js"]
